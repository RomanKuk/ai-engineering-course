# ── LLM Provider (pick one or both; OpenAI is used first if set) ──────────────

# OpenAI — https://platform.openai.com/api-keys (default provider)
OPENAI_API_KEY=

# OpenRouter — https://openrouter.ai/keys (fallback; used when OPENAI_API_KEY is empty)
OPENROUTER_API_KEY=

# ── Vector DB ─────────────────────────────────────────────────────────────────

# Qdrant Cloud — https://cloud.qdrant.io (free tier)
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=

# ── Rate Limiting ─────────────────────────────────────────────────────────────

# Upstash Redis — https://upstash.com (free tier), use rediss:// URL
UPSTASH_REDIS_URL=rediss://default:your-password@your-endpoint.upstash.io:6379

# ── Observability ─────────────────────────────────────────────────────────────

# Langfuse — https://cloud.langfuse.com (free tier)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Storage ───────────────────────────────────────────────────────────────────

# SQLite path (default: costs.db in working dir)
DB_PATH=costs.db
